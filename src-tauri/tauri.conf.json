{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAGE",
  "version": "2.0.1",
  "identifier": "app.kage.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KAGE Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#0A0908"
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/KAGE/**", "$HOME/Videos/KAGE/**", "$APPDATA/KAGE/thumbs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Lightweight instant replay and direct capture studio for Windows",
    "longDescription": "KAGE keeps the last 15 to 300 seconds of your screen in a GPU-encoded rolling memory buffer (Alt + C) and streams direct MP4 recordings straight to disk (Alt + R) with zero cloud, zero telemetry, and minimal memory overhead."
  }
}
